# Example credentials configuration file used with managed locally Agent
{% if 'access_key_id' in data and 'secret_access_key' in data %}
credentials:
  aws-secrets-manager:
    auth:
      type: static
      access-key-id: {{ data.access_key_id }}
      secret-access-key: {{ data.secret_access_key }}
      region: us-east-1
{% endif %}
